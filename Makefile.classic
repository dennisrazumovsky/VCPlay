# either linux or dragonfly
SYSTEM?=linux

DESTDIR?=
PREFIX?=/usr/local
LIBSUFFIX?=
LIBDIR?=$(PREFIX)/lib$(LIBSUFFIX)
MANDIR?=$(PREFIX)/share/man
SBINDIR?=$(PREFIX)/sbin
INCLUDEDIR?=$(PREFIX)/include

# either openssl or gcrypt
PBKDF_BACKEND?=openssl

# system compiler, normally gcc
CC?=gcc

INSTALL?=install

RM?=rm -f

LN?=ln

# whether to enable debugging or not
DEBUG?=no

MAJ_VER=3
MIN_VER=3


# I've given up on -Werror for now; many Linux distros have warnings even in
# their standard header files.
WARNFLAGS= -Wsystem-headers -Wall -W -Wno-unused-parameter \
	-Wstrict-prototypes -Wmissing-prototypes -Wpointer-arith \
	-Wold-style-definition -Wreturn-type -Wwrite-strings \
	-Wswitch -Wshadow -Wcast-align -Wunused-parameter -Wchar-subscripts \
	-Winline -Wnested-externs

VER_FLAGS= -DMAJ_VER=$(MAJ_VER) -DMIN_VER=$(MIN_VER) -D_FILE_OFFSET_BITS=64

SRCS=	vcplay.c crc32.c safe_mem.c io.c hdr.c humanize.c
SRCS+=	crypto.c generic_xts.c
OBJS=	vcplay.o crc32.o safe_mem.o io.o hdr.o humanize.o
OBJS+=	crypto.o generic_xts.o

COMMON_CFLAGS= $(WARNFLAGS) -fPIC $(VER_FLAGS)

ifeq ($(DEBUG), yes)
  COMMON_CFLAGS+= -O0 -g -DDEBUG
else
  COMMON_CFLAGS+= -O3
endif

ifeq (${SYSTEM}, linux)
  COMMON_CFLAGS+=	-D_GNU_SOURCE
  LIBS+=	-lgcrypt -lgpg-error -ldevmapper -luuid
  SRCS+=	crypto-gcrypt.c
  OBJS+=	crypto-gcrypt.o
  ifeq (${PBKDF_BACKEND}, gcrypt)
    SRCS+=	pbkdf2-gcrypt.c
    OBJS+=	pbkdf2-gcrypt.o
  endif
  ifeq (${PBKDF_BACKEND}, openssl)
    SRCS+=	pbkdf2-openssl.c
    OBJS+=	pbkdf2-openssl.o
    LIBS+=	-lcrypto
  endif
endif

ifeq (${SYSTEM}, dragonfly)
  LIBS+=	-lcrypto -ldm -lprop
  SRCS+=	crypto-dev.c
  OBJS+=	crypto-dev.o
  SRCS+=	pbkdf2-openssl.c
  OBJS+=	pbkdf2-openssl.o
endif

OBJS_PROG= $(OBJS) main.o
OBJS_LIB= $(OBJS) vcplay_api.o

all: vcplay libvcplay.so libvcplay.a

%.o: %.c
	$(CC) $(COMMON_CFLAGS) $(CFLAGS)   -c -o $@ $<

vcplay: $(OBJS_PROG)
	$(CC) $(COMMON_CFLAGS) $(CFLAGS)   -o vcplay $(OBJS_PROG) $(LIBS)

libvcplay.so.$(MAJ_VER).$(MIN_VER): $(OBJS_LIB)
	$(CC) -shared -Wl,-version-script=vcplay.map -Wl,-soname=libvcplay.so.$(MAJ_VER).$(MIN_VER)  $(LDFLAGS) \
		-o libvcplay.so.$(MAJ_VER).$(MIN_VER) $(OBJS_LIB) $(LIBS)

libvcplay.so: libvcplay.so.$(MAJ_VER).$(MIN_VER)
	$(LN) -sf libvcplay.so.$(MAJ_VER).$(MIN_VER) libvcplay.so

libvcplay.a: $(OBJS_LIB)
	$(AR) -rs libvcplay.a $(OBJS_LIB)


install: install_program install_lib install_lib_static

install_program: vcplay install_man8
	$(INSTALL) -d "$(DESTDIR)$(SBINDIR)"
	$(INSTALL) vcplay "$(DESTDIR)$(SBINDIR)"

install_lib: libvcplay.so.$(MAJ_VER).$(MIN_VER) libvcplay.so install_h install_man3
	$(INSTALL) -d "$(DESTDIR)$(LIBDIR)"
	$(INSTALL) libvcplay.so.$(MAJ_VER).$(MIN_VER) "$(DESTDIR)$(LIBDIR)"
	$(LN) -sf libvcplay.so.$(MAJ_VER).$(MIN_VER) "$(DESTDIR)$(LIBDIR)/libvcplay.so"

install_lib_static: libvcplay.a install_h install_man3
	$(INSTALL) -d "$(DESTDIR)$(LIBDIR)"
	$(INSTALL) libvcplay.a "$(DESTDIR)$(LIBDIR)"

install_h: vcplay_api.h
	$(INSTALL) -d "$(DESTDIR)$(INCLUDEDIR)"
	$(INSTALL) vcplay_api.h "$(DESTDIR)$(INCLUDEDIR)"

install_man3: vcplay.3
	$(INSTALL) -d "$(DESTDIR)$(MANDIR)/man3"
	$(INSTALL) vcplay.3 "$(DESTDIR)$(MANDIR)/man3"

install_man8: vcplay.8
	$(INSTALL) -d "$(DESTDIR)$(MANDIR)/man8"
	$(INSTALL) vcplay.8 "$(DESTDIR)$(MANDIR)/man8"


clean_cmake_mess:
	$(RM) CMakeCache.txt
	$(RM) -r CMakeFiles
	$(RM) CPackConfig.cmake
	$(RM) CPackSourceConfig.cmake
	$(RM) Makefile
	$(RM) cmake_install.cmake
	$(RM) vcplay.pc

clean: clean_cmake_mess
	$(RM) $(OBJS_PROG)
	$(RM) $(OBJS_LIB)
	$(RM) vcplay libvcplay.so* libvcplay.a vcplay.core ktrace.out

.PHONY: install install_program install_lib install_lib_static install_man3 install_man8 install_h
